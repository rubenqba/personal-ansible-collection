{
  "name": "Ansible Collection Development",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "python -m pip install --upgrade pip && pip install -r requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.ansible",
        "redhat.vscode-yaml",
        "ms-python.python",
        "charliermarsh.ruff",
        "samuelcolvin.jinjahtml",
        "Anthropic.claude-code",
        "leodevbro.blockman",
        "mikestead.dotenv",
        "EditorConfig.EditorConfig",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "ansible.python.interpreterPath": "/usr/local/bin/python",
        "yaml.schemas": {
          "https://raw.githubusercontent.com/ansible/ansible-lint/main/src/ansiblelint/schemas/ansible.json": "/*.yml"
        }
      }
    }
  },
  "remoteUser": "vscode"
}
